word = input("Enter a word: ")

if word.endswith("ing"):
    root = word[:-3]
    affix = "ing"
elif word.endswith("ed"):
    root = word[:-2]
    affix = "ed"
elif word.endswith("s"):
    root = word[:-1]
    affix = "s"
else:
    root = word
    affix = "None"

print("Original Word:", word)
print("Root Word:", root)
print("Affix:", affix)
